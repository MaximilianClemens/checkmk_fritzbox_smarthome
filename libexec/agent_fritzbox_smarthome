#!/usr/bin/env python3
"""Special agent for Fritz!Box smarthome devices.

Logs in to the Fritz!Box via login_sid.lua (PBKDF2 challenge-response,
MD5 fallback for old Fritz!OS versions) and dumps the AHA device list
as JSON into the <<<fritzbox_smarthome:json>>> section.
"""

import argparse
import hashlib
import json
import sys
import xml.etree.ElementTree as ET

import requests
import urllib3

INVALID_SID = "0000000000000000"
LOGIN_TIMEOUT = 15
DATA_TIMEOUT = 60


def parse_args():
    parser = argparse.ArgumentParser(description="Special Agent for Fritzbox Smarthome")
    parser.add_argument("--host", required=True)
    parser.add_argument("--username", required=True)
    parser.add_argument("--password", required=True)
    parser.add_argument("--port", type=int, default=80)
    parser.add_argument("--protocol", choices=["http", "https"], default="http")
    parser.add_argument("--ignore-ssl", action="store_true", default=False)
    parser.add_argument(
        "--login-method",
        choices=["auto", "pbkdf2", "md5"],
        default="auto",
        help="auto: PBKDF2 if offered by the box, otherwise MD5 (default)",
    )
    parser.add_argument("--debug", action="store_true", default=False)
    return parser.parse_args()


def calculate_pbkdf2_response(challenge, password):
    """Response for a PBKDF2 challenge ("2$<iter1>$<salt1>$<iter2>$<salt2>").

    See AVM Technical Note "Session-ID" (Fritz!OS >= 7.24).
    """
    parts = challenge.split("$")
    if len(parts) != 5:
        raise ValueError(f"Malformed PBKDF2 challenge: {challenge!r}")
    iter1 = int(parts[1])
    salt1 = bytes.fromhex(parts[2])
    iter2 = int(parts[3])
    salt2 = bytes.fromhex(parts[4])
    hash1 = hashlib.pbkdf2_hmac("sha256", password.encode(), salt1, iter1)
    hash2 = hashlib.pbkdf2_hmac("sha256", hash1, salt2, iter2)
    return f"{parts[4]}${hash2.hex()}"


def calculate_md5_response(challenge, password):
    """Legacy MD5 response for Fritz!OS < 7.24.

    AVM requires UTF-16LE and replaces code points > 255 with ".".
    """
    password = "".join(c if ord(c) < 256 else "." for c in password)
    md5 = hashlib.md5(f"{challenge}-{password}".encode("utf-16le")).hexdigest()
    return f"{challenge}-{md5}"


def _parse_login_xml(content):
    try:
        xml = ET.fromstring(content)
    except ET.ParseError:
        raise Exception(f"Did not receive XML from login_sid.lua, got: {content[:200]!r}")
    return xml


def login(base_url, username, password, verify_ssl, debug, login_method="auto"):
    # version=2 asks the box for a PBKDF2 challenge; older boxes ignore it
    # and still return an MD5 challenge. Without version=2 every box returns
    # an MD5 challenge.
    sid_url = f"{base_url}/login_sid.lua"
    if login_method != "md5":
        sid_url += "?version=2"
    r = requests.get(sid_url, verify=verify_ssl, timeout=LOGIN_TIMEOUT)
    r.raise_for_status()
    xml = _parse_login_xml(r.content)

    sid = xml.findtext("SID")
    if sid and sid != INVALID_SID:
        return sid  # already authenticated (should not happen without cookie)

    blocktime = int(xml.findtext("BlockTime") or 0)
    if blocktime > 0:
        raise Exception(f"Login blocked for {blocktime} seconds")

    challenge = xml.findtext("Challenge")
    if not challenge:
        raise Exception(f"No login challenge received, got: {r.content[:200]!r}")

    is_pbkdf2 = challenge.startswith("2$")
    if login_method == "pbkdf2" and not is_pbkdf2:
        raise Exception(
            "Login method PBKDF2 requested but the box only offers an MD5 challenge "
            "(Fritz!OS older than 7.24?). Use login method 'auto' or 'md5'."
        )
    if login_method == "md5" and is_pbkdf2:
        raise Exception(
            "Login method MD5 requested but the box returned a PBKDF2 challenge. "
            "Use login method 'auto' or 'pbkdf2'."
        )

    if is_pbkdf2:
        response = calculate_pbkdf2_response(challenge, password)
        method = "PBKDF2"
    else:
        response = calculate_md5_response(challenge, password)
        method = "MD5"
    if debug:
        sys.stderr.write(f"Login challenge type: {method} (requested: {login_method})\n")

    r = requests.post(
        sid_url,
        data={"username": username, "response": response},
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        verify=verify_ssl,
        timeout=LOGIN_TIMEOUT,
    )
    r.raise_for_status()
    xml = _parse_login_xml(r.content)

    sid = xml.findtext("SID")
    if not sid or sid == INVALID_SID:
        blocktime = int(xml.findtext("BlockTime") or 0)
        hint = f" (login blocked for {blocktime} seconds)" if blocktime > 0 else ""
        raise Exception(f"Authentication failed{hint}")

    return sid


def logout(base_url, sid, verify_ssl):
    try:
        requests.get(
            f"{base_url}/login_sid.lua",
            params={"logout": "1", "sid": sid},
            verify=verify_ssl,
            timeout=LOGIN_TIMEOUT,
        )
    except requests.RequestException:
        pass  # best effort, the session expires on its own


def fetch_device_info(base_url, sid, verify_ssl, debug):
    r = requests.get(
        f"{base_url}/webservices/homeautoswitch.lua",
        params={"switchcmd": "getdevicelistinfos", "sid": sid},
        verify=verify_ssl,
        timeout=DATA_TIMEOUT,
    )
    r.raise_for_status()
    if debug:
        sys.stderr.write("RAW device list:\n" + r.text + "\n")

    devices = []
    root = ET.fromstring(r.content)
    for device in root.findall("device"):
        dev = {
            "id": device.get("id"),
            "manufacturer": device.get("manufacturer"),
            "productname": device.get("productname"),
            "fwversion": device.get("fwversion"),
            "functionbitmask": device.get("functionbitmask"),
            "identifier": device.get("identifier"),
            "present": device.findtext("present"),
            "name": device.findtext("name"),
            "txbusy": device.findtext("txbusy"),
            "battery": device.findtext("battery"),
            "batterylow": device.findtext("batterylow"),
            "data": {},
        }

        # every child element with sub elements becomes a dict (hkr, switch,
        # powermeter, temperature, humidity, alert, button, ...)
        for sub in device:
            if len(sub) == 0:
                continue
            dev["data"][sub.tag] = {elem.tag: elem.text for elem in sub}

        devices.append(dev)

    return devices


def main():
    args = parse_args()
    verify_ssl = not args.ignore_ssl
    if not verify_ssl:
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
    base_url = f"{args.protocol}://{args.host}:{args.port}"

    try:
        sid = login(base_url, args.username, args.password, verify_ssl, args.debug, args.login_method)
    except Exception as e:
        sys.stderr.write(f"Login to {base_url} failed: {e}\n")
        return 1

    try:
        device_data = fetch_device_info(base_url, sid, verify_ssl, args.debug)
    except Exception as e:
        sys.stderr.write(f"Fetching device list from {base_url} failed: {e}\n")
        return 1
    finally:
        logout(base_url, sid, verify_ssl)

    # sep(0): keep each line as one column so whitespace in names survives
    print("<<<fritzbox_smarthome:sep(0)>>>")
    print(json.dumps(device_data, indent=2 if args.debug else None))
    return 0


if __name__ == "__main__":
    sys.exit(main())
